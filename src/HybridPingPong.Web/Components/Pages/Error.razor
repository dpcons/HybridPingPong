@page "/Error"
@using System.Diagnostics
@using HybridPingPong.Web.Components.Shared
@inject LanguageService Lang

<PageTitle>@Lang["error.pageTitle"]</PageTitle>

<div style="padding:16px 22px;">
    <LanguageSelector ReloadOnChange="true" />
</div>

<h1 class="text-danger">@Lang["error.h1"]</h1>
<h2 class="text-danger">@Lang["error.h2"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Lang["error.requestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Lang["error.devMode"]</h3>
<p>@Lang["error.devModeP1"]</p>
<p>
    <strong>@Lang["error.devModeP2.warn"]</strong>
    @Lang["error.devModeP2.rest"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
