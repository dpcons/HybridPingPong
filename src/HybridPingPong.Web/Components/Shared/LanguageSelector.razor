@using HybridPingPong.Web.Localization
@inject LanguageService Lang
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<label class="hpp-language">
    @Lang["common.language"]:
    <select value="@Lang.Language" @onchange="OnChanged">
        @foreach (var item in Translations.Supported)
        {
            <option value="@item.Code">@item.Label</option>
        }
    </select>
</label>

@code {
    [Parameter] public bool ReloadOnChange { get; set; }

    protected override void OnInitialized()
    {
        Lang.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task OnChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value)) return;

        try
        {
            await JS.InvokeVoidAsync(
                "eval",
                $"document.cookie = '{LanguageService.CookieName}={value}; path=/; max-age=31536000; samesite=lax'");
        }
        catch
        {
            // JS unavailable during prerender; cookie will be set on next interactive change.
        }

        Lang.Language = value;

        if (ReloadOnChange)
        {
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
    }

    public void Dispose()
    {
        Lang.LanguageChanged -= OnLanguageChanged;
    }
}
