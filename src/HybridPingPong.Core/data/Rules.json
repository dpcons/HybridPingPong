      "name": "EmailRegex",
      "pattern": "\\b[\\w.+-]+@[\\w-]+\\.[\\w.-]+\\b",
      "flags": "None"
    },
    {
      "name": "CreditCardRegex",
      "pattern": "\\b(?:\\d[ -]*?){13,19}\\b",
